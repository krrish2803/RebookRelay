generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Users & Auth
model Clinic {
  id              String    @id @default(cuid())
  name            String
  businessType    String    // 'clinic', 'salon', 'dental', 'physio', 'home_service'
  timezone        String    // 'Asia/Kolkata', etc.
  phone           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  staff           Staff[]
  oauthTokens     OAuthToken[]
  calendarEvents  CalendarEvent[]
  recoveryCases   RecoveryCase[]
  waitlistPeople  WaitlistPerson[]
}

model Staff {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email           String    @unique
  name            String
  passwordHash    String?   // Added to fix Prisma crash
  role            String    // 'admin', 'staff', 'viewer'
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clinicId])
  @@index([email])
}

// OAuth & Authentication
model OAuthToken {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider        String    // 'google_calendar'
  accessToken     String    @db.Text // Encrypted
  refreshToken    String    @db.Text // Encrypted
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([clinicId, provider])
  @@index([clinicId])
}

// Calendar Sync
model CalendarEvent {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  googleEventId     String    @unique
  clientName        String
  clientEmail       String
  clientPhone       String
  serviceType       String    // 'Hair Coloring', 'Consultation', etc.
  durationMin       Int
  scheduledStart    DateTime
  scheduledEnd      DateTime
  status            String    // 'confirmed', 'cancelled', 'no_show'
  notes             String?   @db.Text
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  recoveryCase      RecoveryCase?

  @@index([clinicId])
  @@index([googleEventId])
  @@index([status])
  @@index([scheduledStart])
}

// Recovery Cases (No-Show Incidents)
model RecoveryCase {
  id                    String    @id @default(cuid())
  clinicId              String
  clinic                Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  calendarEventId       String    @unique
  calendarEvent         CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  // Original Appointment Details
  originalClientId      String
  originalClientName    String
  originalClientPhone   String
  originalAppointmentStart DateTime
  originalServiceType   String
  originalServiceDurationMin Int

  // Available Recovery Slots (stored as JSON array)
  availableSlots        Json      // [ { start_time, end_time, service_duration } ]

  // Cascade State
  cascadeStatus         String    // 'PENDING_CALL_1', 'PENDING_CALL_2', 'PENDING_CALL_3', 'BOOKED', 'COMPLETED'
  maxCascadeDepth       Int       @default(3)
  currentCallDepth      Int       @default(0)

  // Final Outcome
  finalOutcome          String?   // 'BOOKED', 'NOT_BOOKED', 'PENDING'
  bookedSlot            Json?     // { start_time, end_time, booked_person_id, booked_person_name }
  revenueRecovered      Decimal?  @db.Decimal(8, 2)

  // Metadata
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  // Relations
  callAttempts          CallAttempt[]

  @@index([clinicId])
  @@index([cascadeStatus])
  @@index([createdAt])
}

// Call Attempts (Individual Calls in Cascade)
model CallAttempt {
  id                    String    @id @default(cuid())
  recoveryCaseId        String
  recoveryCase          RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  // Call Details
  callSequence          Int       // 1, 2, or 3
  calleCallId           String    @unique
  targetPersonId        String
  targetPersonName      String
  targetPersonPhone     String

  // Call Outcome
  outcome               String    // 'BOOKED', 'DECLINED', 'NO_ANSWER', 'PARTIAL', 'ERROR'
  sentimentScore        Float?    // 0.0–1.0
  transcript            String?   @db.Text
  notes                 String?   @db.Text
  recordingUrl          String?
  callDurationSec       Int?

  // Timing
  initiatedAt           DateTime
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([recoveryCaseId])
  @@index([calleCallId])
  @@index([outcome])
  @@index([completedAt])
}

// Waitlist Management
model WaitlistPerson {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Contact Info
  name              String
  phone             String
  email             String

  // Preferences
  serviceType       String    // Must match service types in clinic
  preferredTimes    Json      // [ { day_of_week, start_hour, end_hour } ]

  // Waitlist Status
  daysOnWaitlist    Int
  status            String    // 'ACTIVE', 'BOOKED', 'UNAVAILABLE'
  priorityScore     Float?    // Calculated field: (days_waiting / 30) * 0.6 + (recency * 0.4)

  // Booking History (optional, for scoring)
  lastBookedAt      DateTime?
  noShowCount       Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clinicId])
  @@index([serviceType])
  @@index([status])
  @@index([priorityScore])
}

// Optional: Audit Log (for compliance & debugging)
model AuditLog {
  id                String    @id @default(cuid())
  clinicId          String
  action            String    // 'case_created', 'call_initiated', 'cascade_completed', etc.
  entityType        String    // 'RecoveryCase', 'CallAttempt', 'CalendarEvent'
  entityId          String
  changes           Json?     // Old and new values
  performedBy       String?   // User email or 'system'
  ipAddress         String?
  createdAt         DateTime  @default(now())

  @@index([clinicId])
  @@index([action])
  @@index([createdAt])
}
